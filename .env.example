# Copie para .env e ajuste se as portas padrão já estiverem em uso na sua máquina.
# O .env é lido pelo Docker Compose e pelo Makefile (make run, make db-*).

# Porta do host onde a API é publicada
API_PORT=8000

# Porta do host onde o PostgreSQL é publicado
DB_PORT=5432

# Porta do host onde o frontend é publicado
FRONTEND_PORT=5173

# Banco. Valores só de desenvolvimento local; em qualquer outro ambiente, troque
# a senha no .env, que não é versionado. O Postgres só aplica usuário e senha ao
# criar o volume: depois de trocar, recrie com docker compose down -v.
POSTGRES_USER=c216
POSTGRES_PASSWORD=c216
POSTGRES_DB=c216

# As duas abaixo já acompanham as portas acima; descomente só para sobrescrever.

# URL da API vista pelo navegador. Entra no bundle durante o build: se mudar,
# reconstrua a imagem (make up-build).
# VITE_API_URL=http://localhost:8000

# Origens liberadas no CORS, separadas por vírgula. Nunca use "*".
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
