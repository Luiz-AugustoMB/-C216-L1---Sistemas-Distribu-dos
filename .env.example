# Banco de dados: usados pelo container do PostgreSQL e na DATABASE_URL do backend.
# No compose a URL aponta para o serviço db. Fora do Docker (make test, make migrate),
# o Makefile monta a mesma URL com localhost e a DB_PORT
POSTGRES_USER=acervo
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=acervo

# Portas no host: troque se 8000 ou 5432 já estiverem em uso
API_PORT=8000
DB_PORT=5432

# Origens do frontend que podem chamar a API (CORS), separadas por vírgula
CORS_ORIGINS=http://localhost:5173

# Endereço da API usado pelo frontend. É localhost, e não o serviço backend do compose,
# porque quem faz as chamadas é o navegador, fora da rede do Docker
VITE_API_URL=http://localhost:8000
